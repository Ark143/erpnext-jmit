   "fieldtype": "Int",
   "non_negative": 1,
   "default": "1"
  },
  {
   "label": "Max Extra Beds",
   "fieldname": "max_extra_beds",
   "fieldtype": "Int",
   "non_negative": 1,
   "default": "1"

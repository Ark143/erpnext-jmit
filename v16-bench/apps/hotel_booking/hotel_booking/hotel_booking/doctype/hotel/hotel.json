   "fieldname": "address_line1",
   "fieldtype": "Data"
  },
  {
   "label": "Address Line 2",
   "fieldname": "address_line2",
   "fieldtype": "Data"
  },
  {
   "label": "City",
   "fieldname": "city",
   "fieldtype": "Data",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {

  },
  {
   "label": "Website",
   "fieldname": "website",
   "fieldtype": "Data",
   "options": "URL"
  },
  {
   "label": "Amenities & Settings",
   "fieldname": "amenities_section",
   "fieldtype": "Section Break"
  },
  {

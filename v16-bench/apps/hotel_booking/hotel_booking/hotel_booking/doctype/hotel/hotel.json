  },
  {
   "label": "Description",
   "fieldname": "description",
   "fieldtype": "Text Editor"
  },
  {
   "label": "Disabled",
   "fieldname": "disabled",
   "fieldtype": "Check",
   "default": "0"
  }
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Hotel Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "Hotel User", "read": 1}
 ]
}
